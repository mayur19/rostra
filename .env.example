# Rostra local configuration. run.sh copies this to .env and fills SESSION_SECRET.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4108
WEB_PORT=5108
APP_ORIGIN=http://localhost:5108
# Local socket connection as the current OS user (no password).
DATABASE_URL=postgresql://localhost:5432/rostra_dev?host=/tmp
TEST_DATABASE_URL=postgresql://localhost:5432/rostra_test?host=/tmp
SESSION_SECRET=replace-me-with-a-long-random-local-only-value
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
LOG_LEVEL=info
# Login throttles (in-process; see docs/adr/0006). Per IP+email and per IP use the window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=50
# Per-email progressive backoff: free failures, then base delay doubling up to the max.
LOGIN_EMAIL_FREE_ATTEMPTS=5
LOGIN_EMAIL_BACKOFF_BASE_MS=30000
LOGIN_EMAIL_BACKOFF_MAX_MS=3600000
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# Reverse proxies whose X-Forwarded-For is trusted: false, a hop count, or IPs/CIDRs
# (e.g. 127.0.0.1 behind a local nginx). Never "true".
TRUST_PROXY=false
SOLVER_MAX_ITERATIONS=200000
