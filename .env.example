# Rostra local configuration. run.sh copies this to .env and fills SESSION_SECRET.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4108
WEB_PORT=5108
APP_ORIGIN=http://localhost:5108
# Local socket connection as the current OS user (no password).
DATABASE_URL=postgresql://localhost:5432/rostra_dev?host=/tmp
TEST_DATABASE_URL=postgresql://localhost:5432/rostra_test?host=/tmp
SESSION_SECRET=replace-me-with-a-long-random-local-only-value
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
LOG_LEVEL=info
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
SOLVER_MAX_ITERATIONS=200000
